# SQL Server connection
DB_SERVER=localhost
DB_NAME=RealtimeEcommerceDB
# Leave DB_DRIVER empty to auto-detect ODBC Driver 18 or 17
DB_DRIVER=
DB_TRUSTED_CONNECTION=yes
DB_USERNAME=
DB_PASSWORD=

# API settings
API_HOST=127.0.0.1
API_PORT=8000
# Optional: set a long random value to require X-API-Key on write endpoints
API_KEY=
